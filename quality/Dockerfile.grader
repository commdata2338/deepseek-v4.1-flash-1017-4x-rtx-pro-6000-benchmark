FROM python:3.12-slim-bookworm
# Only dependencies used by the data and grading APIs; no inference backends.
RUN pip install --no-cache-dir evalplus==0.3.1 --no-deps && \
    pip install --no-cache-dir numpy==2.1.3 psutil==6.1.1 datasets==3.6.0 \
        wget==3.2 tempdir==0.7.1 appdirs==1.4.4 multipledispatch==1.0.0 && \
    useradd --uid 10001 --create-home grader
ENV XDG_CACHE_HOME=/opt/cache PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
COPY export_tasks.py /opt/export_tasks.py
RUN python /opt/export_tasks.py --output /opt/tasks
COPY grade_inner.py /opt/grade_inner.py
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python", "/opt/grade_inner.py"]
