FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    npm install --global --no-audit --no-fund @earendil-works/pi-coding-agent@0.86.1 && \
    useradd --uid 10001 --create-home --shell /bin/bash agent
COPY pi-config /opt/pi-config
COPY agent_entry.py /opt/agent_entry.py
ENV HOME=/home/agent PI_CODING_AGENT_DIR=/home/agent/pi PI_OFFLINE=1 PI_TELEMETRY=0 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python", "/opt/agent_entry.py"]
